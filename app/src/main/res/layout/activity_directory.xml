<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_solid_button"
        android:padding="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBackDirectory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◁ Back"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus Directory"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/llHeader"
        android:layout_margin="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Search buildings or labs..."
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#102A43"
        android:maxLines="1"
        android:inputType="text"/>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No locations found."
        android:textColor="#627D98"
        android:textSize="18sp"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/lvDirectory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/etSearch"
        android:layout_above="@id/btnAdd"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:padding="16dp"
        android:clipToPadding="false"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_solid_button"
        android:text="Add Custom Location"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"/>
</RelativeLayout>