<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:src="@android:drawable/ic_menu_compass"
            android:tint="#0F5D6B"/>

        <TextView
            android:id="@+id/tvCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-black"
            android:text="Create\nAccount"
            android:textColor="#102A43"
            android:textSize="36sp"
            android:lineSpacingExtra="-8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:background="@drawable/bg_input_field"
                android:elevation="2dp"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:textColor="#102A43"
                android:textColorHint="#9FB3C8"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <EditText
                android:id="@+id/etStudentId"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:elevation="2dp"
                android:hint="Student ID (XX-XXXX-XXX)"
                android:inputType="text"
                android:textColor="#102A43"
                android:textColorHint="#9FB3C8"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:elevation="2dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="#102A43"
                android:textColorHint="#9FB3C8"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:drawableEnd="@android:drawable/ic_menu_view" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_solid_button"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#627D98" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log In"
                android:textColor="#0F5D6B"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>